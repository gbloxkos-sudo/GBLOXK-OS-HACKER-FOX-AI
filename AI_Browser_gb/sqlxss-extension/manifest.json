{
  "manifest_version": 3,
  "name": "GBLOXK SQL/XSS Finder",
  "version": "1.0.1",
  "description": "Find SQLi/XSS injection points on a page and generate sqlmap commands.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "GBLOXK SQL/XSS Finder",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "webai-sqlxss@local",
      "strict_min_version": "109.0"
    }
  }
}
